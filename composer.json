{
    "name": "optimit/engine",
    "description": "Optimit framework for general PHP websites.",
    "authors": [
        {
            "name": "Vyacheslav Matsnev",
            "email": "stacmv@goptimit.ru"
        }
    ],
	"minimum_stability": "dev",
    "require": {
		"php": ">=8.0",
		"optimit/glog_util": "^8.0",
		"erusev/parsedown": "dev-master",
		"mobiledetect/mobiledetectlib": "^2.8",
		"intervention/image": "^2.3@dev",
		"ext-mbstring": "*",
		"ext-bcmath": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^12"
	},
	"autoload-dev": {
		"psr-4": {
			"Engine\\Tests\\": "tests/"
		}
	},
	"suggest": {
		"giggsey/libphonenumber-for-php": "Allows validating international phone numbers"
	}
}
